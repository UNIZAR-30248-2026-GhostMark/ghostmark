# Plantilla: copiar a .env (nunca se commitea) y rellenar en local.
# JWT_SECRETO: al menos 32 bytes. En produccion va en el PaaS, nunca aqui.
JWT_SECRETO=cambia-esto-en-tu-fichero-local-punto-env
# Gemini (misiones con IA). Sin clave, pedir una tanda responde 503 IA_NO_DISPONIBLE y la partida
# sigue con la biblioteca. La clave se saca gratis en Google AI Studio; en produccion va en Render.
GEMINI_CLAVE=
GEMINI_MODELO=gemini-3.6-flash
