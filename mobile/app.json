{
  "expo": {
    "name": "GhostMark",
    "slug": "ghostmark",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1A0B2E"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GhostMark usa tu ubicación solo para comprobar zonas seguras al eliminar."
        }
      ]
    ]
  }
}
