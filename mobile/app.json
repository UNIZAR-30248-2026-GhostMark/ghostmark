{
  "expo": {
    "name": "GhostMark",
    "slug": "ghostmark",
    "scheme": "ghostmark",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1A0B2E"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GhostMark usa tu ubicación solo para comprobar zonas seguras al eliminar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c091aa49-6c50-4e7e-a7df-625224efe8e8"
      }
    },
    "owner": "ghostmark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c091aa49-6c50-4e7e-a7df-625224efe8e8"
    },
    "android": {
      "package": "com.ghostmark.ghostmark"
    },
    "ios": {}
  }
}
